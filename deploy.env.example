# =============================================================================
# deploy.env — Configuration for your Snowflake environment
# Copy this file to deploy.env and fill in your values.
# =============================================================================

# Snowflake Account (e.g., "xy12345" or "myorg-myaccount")
SNOWFLAKE_ACCOUNT=

# Snowflake username (for Docker registry login)
SNOWFLAKE_USER=

# Role used to run the SQL scripts.
#   - Set to a role that can create databases, compute pools, and image repositories
#     (SYSADMIN or ACCOUNTADMIN normally).
#   - Leave BLANK to omit the `USE ROLE` statement entirely and inherit whatever role
#     your session already has. Do this when running in a restricted session where
#     `USE ROLE SYSADMIN` would fail.
DEPLOY_ROLE=SYSADMIN

# App database and schema (where tables, data, and services live)
APP_DATABASE=AGENTIC_DENIED_CLAIMS_HANDLING
APP_SCHEMA=DENIED_CLAIMS

# Platform database (where Cortex Code Agent SDK service lives)
PLATFORM_DATABASE=CORTEX_CODE_DB

# Warehouse name
WAREHOUSE=COMPUTE_WH

# Compute pool name
COMPUTE_POOL=CORTEX_CODE_POOL

# Cortex host (your-account.snowflakecomputing.com)
CORTEX_HOST=

# OPTIONAL: the regional host form, e.g. ab12345.us-west-2.aws.snowflakecomputing.com
# Inside SPCS, the SNOWFLAKE_HOST env var uses this regional form rather than the
# account URL above. The app prefers CORTEX_HOST but falls back to SNOWFLAKE_HOST, so
# setting this adds the regional host to the Cortex egress rule and avoids a blocked
# egress that surfaces only as a generic "error reaching the agent" in the UI.
# Find it with:  SELECT CURRENT_ACCOUNT() || '.' || CURRENT_REGION();
# or read it from a running service's logs (the app logs its resolved Cortex host).
SNOWFLAKE_REGIONAL_HOST=

# Platform endpoint (filled after deploying the platform service)
# Get this from: SHOW ENDPOINTS IN SERVICE <PLATFORM_DATABASE>.SPCS.CORTEX_CODE_SERVICE;
# Use the ingress_url WITHOUT the https:// prefix
PLATFORM_ENDPOINT=

# Personal Access Token (create in Snowsight: User > Settings > Authentication)
SNOWFLAKE_PAT=
